{
  "name": "woper-net-studio",
  "version": "0.1.0",
  "description": "Landing page de Woper Net Studio, lavado y detallado automotriz en Desamparados, Costa Rica.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "media": "node scripts/prepare-media.mjs",
    "predev": "npm run media",
    "dev": "astro dev",
    "prebuild": "npm run media",
    "build": "astro build",
    "preview": "astro preview",
    "check": "npm run media && astro check",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:media": "node scripts/check-media.mjs",
    "test": "node --test scripts/booking.test.mjs",
    "test:a11y": "node scripts/check-a11y.mjs",
    "verify": "npm run check && npm run check:contrast && npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Frago10/Woper-net-Studio.git"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/archivo": "^5.3.0",
    "astro": "^7.4.11",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "typescript": "^6.0.3"
  }
}
