---
/* Siluetas de línea propias y genéricas: no representan ningún modelo ni marca. */
import type { VehicleId } from '../data/site.ts';

interface Props {
  vehicle: VehicleId;
}

const shapes: Record<VehicleId, string> = {
  sedan:
    '<path d="M13 28H6a3 3 0 0 1-3-3v-3a3.5 3.5 0 0 1 3-3.4l12-2.1 9-7A6 6 0 0 1 30.7 8H48a6 6 0 0 1 3.6 1.2l9.4 7.3 11.5 1.6a5 5 0 0 1 4.5 5V25a3 3 0 0 1-3 3h-6.5M53 28H27"/><path d="M24 16.5l7-5.5h16.5l7 5.5zM39.5 11v5.5"/>',
  suv:
    '<path d="M13 28H6a3 3 0 0 1-3-3v-6a3.5 3.5 0 0 1 3-3.4l10-1.1 7-8.5A5.5 5.5 0 0 1 27.3 4H62a5 5 0 0 1 4.2 2.3l4.8 8.2 2.5.7a5 5 0 0 1 3.5 4.8V25a3 3 0 0 1-3 3h-6.5M53 28H27"/><path d="M21.5 14.5l5.6-7H63l4.3 7zM38 7.5v7M52 7.5v7"/>',
  pickup:
    '<path d="M13 28H6a3 3 0 0 1-3-3v-5.5a3.5 3.5 0 0 1 3-3.4l10-1.1 6.5-8A5.5 5.5 0 0 1 26.8 5H42a2 2 0 0 1 2 2v8h31a2 2 0 0 1 2 2v8a3 3 0 0 1-3 3h-6.5M53 28H27"/><path d="M21.5 15l5.4-6.5h13.6V15zM44 15v7"/>',
};

const { vehicle } = Astro.props;
---

<svg class="vehiculos__icono" viewBox="0 0 80 36" aria-hidden="true" focusable="false">
  <Fragment set:html={shapes[vehicle]} />
  <circle cx="20" cy="28" r="6.5" />
  <circle cx="60" cy="28" r="6.5" />
</svg>
