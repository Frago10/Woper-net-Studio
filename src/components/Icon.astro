---
/* Íconos de línea propios. Siempre decorativos: acompañan a un texto o a un aria-label. */
const paths = {
  check: '<path d="M4.5 12.5l5 5 10-11"/>',
  menu: '<path d="M3 8h18M3 16h18"/>',
  cerrar: '<path d="M5 5l14 14M19 5L5 19"/>',
  anterior: '<path d="M15 5l-7 7 7 7"/>',
  siguiente: '<path d="M9 5l7 7-7 7"/>',
  abajo: '<path d="M5 9l7 7 7-7"/>',
  pausa: '<path d="M9 6v12M15 6v12"/>',
  reproducir: '<path d="M8 5.5v13l11-6.5z"/>',
  telefono:
    '<path d="M6.5 3.5h3l1.5 4-2 1.5a12 12 0 0 0 6 6l1.5-2 4 1.5v3a2 2 0 0 1-2 2A16 16 0 0 1 4.5 5.5a2 2 0 0 1 2-2z"/>',
  externo: '<path d="M10 5H5v14h14v-5M14 5h5v5M19 5l-8 8"/>',
} as const;

interface Props {
  name: keyof typeof paths;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg
  class:list={['icono', className]}
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
  set:html={paths[name]}
/>
